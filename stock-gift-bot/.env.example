# LINE Developers > Messaging API channel
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# 後台 http://NAS:13999/admin 的帳密（ADMIN_PASSWORD 沒設 = 後台關閉）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# 新使用者加好友後是否自動核准；false = 要到後台「使用者」按核准
AUTO_APPROVE_USERS=false

# 提醒時間（零股盤中 9:10）與每日更新資料時間
REMIND_TIME=09:10
REFRESH_TIME=08:40
# 最後買進日前幾個「交易日」開始問要不要買
BUY_REMIND_TRADING_DAYS=3
# 投票提醒是否連假日也發 (true/false)
VOTE_REMIND_WEEKENDS=true
# 抓不到投票期間時，用股東會日期推估：開會前 N 天開始 ~ 開會前 M 天截止
VOTE_START_DAYS_BEFORE_MEETING=30
VOTE_END_DAYS_BEFORE_MEETING=3
# 只問昨收 <= 這個價錢的股票，0 = 不限制
MAX_PRICE=0
# 紀念品含這些字就不問（逗號分隔）
SKIP_GIFT_KEYWORDS=無,不發放,未定,未發放

TZ=Asia/Taipei
DB_PATH=/data/bot.db

# docker-compose 的 Cloudflare Tunnel（可選）
CLOUDFLARE_TUNNEL_TOKEN=
# 要啟用 Tunnel 容器就把下一行取消註解
# COMPOSE_PROFILES=tunnel
