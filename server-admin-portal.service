[Unit]
Description=Server Admin Portal
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/server-admin-portal
EnvironmentFile=/etc/server-admin-portal.env
ExecStart=/opt/server-admin-portal/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8787
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
